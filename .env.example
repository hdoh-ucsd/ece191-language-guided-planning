# Set these to paths accessible to the Docker daemon.
# Docker Desktop+WSL2: prefer WSL /home/... paths over Windows /mnt/c/... paths.
# A default is used if you simply copy this file unchanged.
HOST_WEIGHTS_DIR=./weights
HOST_SCENARIONET_DIR=./scenarionet_data
HOST_RESULTS_DIR=./outputs
HOST_NUPLAN_DIR=./nuplan_data
